extends SceneTree

func _init() -> void:
	print("Testing MultiMesh2D and Shader...")
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_2D
	mm.use_colors = true
	mm.use_custom_data = true
	var quad := QuadMesh.new()
	quad.size = Vector2(1.0, 1.0)
	quad.center_offset = Vector3(0.5, 0.5, 0.0) # top-left pivot (0,0) to (1,1)
	mm.mesh = quad
	mm.instance_count = 10
	print("MultiMesh created successfully with 10 instances.")
	quit(0)
